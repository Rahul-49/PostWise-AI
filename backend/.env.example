# Server Port
PORT=5000

# MongoDB Database Connection String
# (If omitted or unreachable, backend automatically uses in-memory mock store)
MONGODB_URI=mongodb://127.0.0.1:27017/postwise_ai

# JSON Web Token Secret
JWT_SECRET=postwise_super_secret_jwt_key_2026_x987

# AI Engine API Key (Groq LLaMA-3.3-70B is prioritized for generation)
GROQ_API=gsk_your_groq_api_key_here

# Optional: OpenAI API Key (used as fallback if Groq API is not provided)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Pexels API Key for Stock Photo Discovery & Carousel Previews
# (Supports either PEXELS_API or PEXELS_API_KEY)
PEXELS_API=your_pexels_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
